{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run python scripts/:*)",
      "Bash(uv run pairs-bt:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(uv tree:*)",
      "Bash(make check)",
      "Bash(make test:*)",
      "Bash(make fmt)",
      "Bash(make lint)",
      "Bash(make type)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(ls:*)",
      "Read(./**)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(uv remove:*)",
      "Edit(./tests/regression/**)",
      "Write(./tests/regression/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./data/raw/**)",
      "Write(./data/raw/**)",
      "Bash(rm -rf data:*)",
      "Bash(rm -rf ./data:*)",
      "Bash(pip install:*)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run ruff format --quiet src tests scripts 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
